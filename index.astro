            // ============================================
            // FUNCIÓN PRINCIPAL DE CHAT
            // ============================================
            async function sendMessage() {
                if (state.isGenerating) return;

                // Get message from either desktop or mobile input
                const desktopInput = document.getElementById("messageInput");
                const mobileInput = document.getElementById("mobileMessageInput");
                const input = window.innerWidth >= 640 ? desktopInput : mobileInput;
                const message = input ? input.value.trim() : '';
                if (!message) return;

                // Ocultar mensaje de bienvenida
                const welcomeMessage = document.getElementById("welcomeMessage");
                if (welcomeMessage) {
                    welcomeMessage.style.display = "none";
                }

                // Actualizar UI
                state.isGenerating = true;
                const sendButton = document.getElementById("sendButton");
                const mobileSendButton = document.getElementById("mobileSendButton");
                
                if (sendButton) {
                    sendButton.disabled = true;
                    sendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> <span>Generando...</span>';
                }
                if (mobileSendButton) {
                    mobileSendButton.disabled = true;
                    mobileSendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                }

                // Añadir mensaje del usuario
                addUserMessage(message);
                
                // IMPORTANTE: Guardar mensaje como objeto simple con strings
                state.messages.push({
                    role: "user",
                    content: message
                });

                if (desktopInput) {
                    desktopInput.value = "";
                    desktopInput.style.height = "auto";
                }
                if (mobileInput) {
                    mobileInput.value = "";
                    mobileInput.style.height = "auto";
                }

                // Crear elemento para respuesta del asistente
                const assistantMsg = createAssistantMessageElement();

                try {
                    // WORKAROUND: Construir el mensaje completo incluyendo el system prompt
                    // porque Puter.js no soporta correctamente el parámetro system
                    const systemPrompt = config.presets[state.currentPreset];
                    
                    let userMessage = message;
                    
                    if (state.messages.length > 1) {
                        // Construir contexto del historial + system prompt
                        let context = `${systemPrompt}\n\nHistorial de la conversación:\n\n`;
                        for (let i = 0; i < state.messages.length - 1; i++) {
                            const msg = state.messages[i];
                            const role = msg.role === 'user' ? 'Usuario' : 'Asistente';
                            context += `${role}: ${msg.content}\n\n`;
                        }
                        context += `Usuario: ${message}`;
                        userMessage = context;
                    } else {
                        // Primer mensaje: incluir system prompt al inicio
                        userMessage = `${systemPrompt}\n\nUsuario: ${message}`;
                    }

                    console.log('📤 Enviando a', state.currentModel);
                    console.log('Preset:', state.currentPreset);
                    console.log('Mensaje con system prompt:', userMessage.substring(0, 200) + '...');

                    // Enviar como un solo mensaje sin parámetro system
                    const response = await puter.ai.chat(userMessage, {
                        model: state.currentModel,
                        stream: true
                    });

                    let fullResponse = "";
                    assistantMsg.element.innerHTML = "";

                    for await (const chunk of response) {
                        if (chunk.text) {
                            fullResponse += String(chunk.text);
                            assistantMsg.element.innerHTML = formatMarkdown(fullResponse);
                            autoScrollToBottom();
                        }
                    }

                    // IMPORTANTE: Guardar respuesta como string simple y puro
                    const cleanResponse = String(fullResponse || '').trim();
                    if (cleanResponse) {
                        state.messages.push({
                            role: "assistant",
                            content: cleanResponse
                        });
                        console.log('✅ Respuesta guardada. Total mensajes:', state.messages.length);
                        console.log('Tipo de contenido guardado:', typeof cleanResponse, 'Es array?', Array.isArray(cleanResponse));
                    }

                    // Guardar chat en el historial si no está en modo incógnito
                    saveChatToHistory();

                    // Intentar generar título con IA en segundo plano
                    maybeGenerateTitleWithAI();

                } catch (error) {
                    console.error("❌ Error:", error);
                    assistantMsg.element.innerHTML = `<p class="text-red-400"><i class="fas fa-exclamation-triangle mr-2"></i>Error al generar respuesta. Por favor, intenta de nuevo.</p>`;
                }

                // Restaurar UI
                state.isGenerating = false;
                if (sendButton) {
                    sendButton.disabled = false;
                    sendButton.innerHTML = '<i class="fas fa-paper-plane"></i> <span>Enviar</span>';
                }
                if (mobileSendButton) {
                    mobileSendButton.disabled = false;
                    mobileSendButton.innerHTML = '<i class="fas fa-paper-plane"></i>';
                }
            }

            // ============================================
            // FUNCIÓN PARA LIMPIAR CHAT
            // ============================================
            function clearChat() {
                state.messages = [];
                state.currentChatId = null;
                state.generatedTitle = null;
                state.lastTitleGenerationCount = 0;
                state.titleGenerationInProgress = false;
                const chatContainer = document.getElementById("chatContainer");
                chatContainer.innerHTML = `
                    <div class="max-w-4xl mx-auto">
                        <div id="welcomeMessage" class="message-wrapper text-center mb-6">
                            <div class="inline-block bg-gradient-to-r from-emerald-600 to-green-500 text-white px-6 py-3 rounded-lg message-enter">
                                <i class="fas fa-hand-holding-medical mr-2"></i>
                                ¡Hola! Soy Doky, tu asistente médico creado por el Dr. Oriol Giner Díaz. Estoy aquí para ayudarte con cualquier consulta sobre salud. ¿En qué puedo ayudarte hoy?
                            </div>
                        </div>
                    </div>
                `;
                selectModel("deepseek-chat");
            }

            // ============================================
            // EVENT LISTENERS
            // ============================================
            window.addEventListener("click", function (event) {
                const newChatModal = document.getElementById("newChatModal");
                const presetModal = document.getElementById("presetChangeModal");

                if (event.target === newChatModal) {
                    closeModal();
                }
                if (event.target === presetModal) {
                    cancelPresetChange();
                }
                if (event.target === document.getElementById("deleteAllHistoryModal")) {
                    closeModal();
                }
                
                // Close bottom sheets when clicking overlay
                if (event.target.classList.contains('bottom-sheet-overlay')) {
                    closeBottomSheets();
                }

                // Cerrar dropdown de modelo
                const dropdown = document.getElementById("modelDropdown");
                if (dropdown && !dropdown.contains(event.target)) {
                    dropdown.classList.remove("active");
                    const modelChevron = document.getElementById("modelChevron");
                    if (modelChevron) modelChevron.style.transform = "rotate(0deg)";
                }

                // Cerrar dropdown de preset
                const presetWrapper = document.getElementById("presetDropdown");
                const presetOpts = document.getElementById("presetOptions");
                const presetChevron = document.getElementById("presetChevron");
                if (presetWrapper && presetOpts && !presetWrapper.contains(event.target)) {
                    presetOpts.classList.add("hidden");
                    if (presetChevron) presetChevron.style.transform = "rotate(0deg)";
                }

                // Cerrar menú de información
                const infoWrapper = document.getElementById("infoMenuWrapper");
                const infoMenu = document.getElementById("infoMenu");
                if (infoWrapper && infoMenu && !infoWrapper.contains(event.target)) {
                    closeInfoMenu();
                }
            });

            document.addEventListener("DOMContentLoaded", function () {
                applyTranslations(state.currentLocale);

                // Detect Android WebView
                const isAndroidWebView = () => {
                    const ua = navigator.userAgent.toLowerCase();
                    return ua.includes('wv') || 
                           (ua.includes('android') && ua.includes('version/') && !ua.includes('chrome/'));
                };

                // Hide info buttons if running in Android WebView
                if (isAndroidWebView()) {
                    const desktopInfoWrapper = document.getElementById('infoMenuWrapper');
                    const mobileInfoButton = document.querySelector('.mobile-info-button');
                    
                    if (desktopInfoWrapper) {
                        desktopInfoWrapper.style.display = 'none';
                    }
                    if (mobileInfoButton) {
                        mobileInfoButton.style.display = 'none';
                    }
                }

                selectModel("deepseek-chat");
                updatePresetDisplay(state.currentPreset);
                
                // Initialize model icons
                const desktopModelIcon = document.getElementById("desktopModelIcon");
                const mobileModelIcon = document.getElementById("mobileModelIcon");
                
                if (desktopModelIcon) {
                    desktopModelIcon.className = config.modelIcons["deepseek-chat"];
                }
                if (mobileModelIcon) {
                    mobileModelIcon.className = config.modelIcons["deepseek-chat"];
                }
                
                // Initialize incognito button
                updateIncognitoButton();
                
                // Close history drawer when clicking outside
                window.addEventListener("click", function (event) {
                    const historyDrawer = document.getElementById("historyDrawer");
                    const historyButton = document.getElementById("historyButton");
                    const mobileMenuDrawer = document.getElementById('mobileMenuDrawer');
                    const mobileMenuBtn = document.getElementById("mobileMenuBtn");
                    
                    if (historyDrawer && (historyDrawer.classList.contains("active") || historyDrawer.classList.contains("closing"))) {
                        const drawerContent = historyDrawer.querySelector('.history-drawer');
                        if (!drawerContent?.contains(event.target) && 
                            !historyButton?.contains(event.target) && 
                            !mobileMenuDrawer?.contains(event.target)) {
                            // If it's already closing, don't interrupt
                            if (!historyDrawer.classList.contains("closing")) {
                                toggleHistoryDrawer();
                            }
                        }
                    }
                    
                    if (mobileMenuDrawer && (mobileMenuDrawer.classList.contains("active") || mobileMenuDrawer.classList.contains("closing"))) {
                        if (!mobileMenuDrawer.contains(event.target) && 
                            !mobileMenuBtn?.contains(event.target)) {
                            // If it's already closing, don't interrupt
                            if (!mobileMenuDrawer.classList.contains("closing")) {
                                toggleMobileMenuDrawer();
                            }
                        }
                    }
                });
                
                const chatContainer = document.getElementById("chatContainer");
                chatContainer.addEventListener("scroll", function () {
                    updateScrollButton();
                    const isAtBottom = chatContainer.scrollTop + chatContainer.clientHeight >= chatContainer.scrollHeight - 50;
                    if (!isAtBottom) {
                        state.shouldAutoScroll = false;
                    }
                });

                // Auto-resize for both desktop and mobile textareas
                const desktopTextarea = document.getElementById("messageInput");
                const mobileTextarea = document.getElementById("mobileMessageInput");
                
                function setupAutoResize(textarea) {
                    if (textarea) {
                        textarea.addEventListener("input", function () {
                            this.style.height = "auto";
                            this.style.height = Math.min(this.scrollHeight, 150) + "px";
                        });
                    }
                }
                
                setupAutoResize(desktopTextarea);
                setupAutoResize(mobileTextarea);
                
                // Sync inputs between mobile and desktop
                if (desktopTextarea && mobileTextarea) {
                    desktopTextarea.addEventListener('input', function() {
                        mobileTextarea.value = this.value;
                    });
                    mobileTextarea.addEventListener('input', function() {
                        desktopTextarea.value = this.value;
                    });
                }

                setupBottomSheetGestures();
            });
        </script>
    </body>
</html>
