            function normalizeLocale(locale) {
                if (!locale) return "es";
                const candidate = locale.toLowerCase().split(/[-_]/)[0];
                return SUPPORTED_LOCALES.includes(candidate) ? candidate : "es";
            }

            function saveLocalePreference(locale) {
                if (typeof window === 'undefined' || typeof window.localStorage === 'undefined') return;
                try {
                    window.localStorage.setItem(LOCALE_STORAGE_KEY, locale);
                } catch (error) {
                    console.warn('No se pudo guardar el idioma preferido:', error);
                }
            }

            function loadLocalePreference() {
                if (typeof window === 'undefined' || typeof window.localStorage === 'undefined') return null;
                try {
                    const stored = window.localStorage.getItem(LOCALE_STORAGE_KEY);
                    return stored ? normalizeLocale(stored) : null;
                } catch (error) {
                    console.warn('No se pudo cargar el idioma preferido:', error);
                    return null;
                }
            }

            const storedLocalePreference = loadLocalePreference();
            if (storedLocalePreference && storedLocalePreference !== state.currentLocale) {
                state.currentLocale = storedLocalePreference;
                if (typeof document !== 'undefined') {
                    document.documentElement.lang = storedLocalePreference;
                }
            }

            function getLocaleData(locale) {
                const code = normalizeLocale(locale);
                return { code, data: translations[code] || translations.es };
            }

            function getFromPath(obj, path) {
                return path.split('.').reduce((acc, segment) => (acc && acc[segment] !== undefined ? acc[segment] : undefined), obj);
            }

            function resolvePlural(entry, params) {
                if (!entry || typeof entry !== 'object') return entry;
                const count = Number(params?.count ?? 0);
                if (count === 1 && entry.one !== undefined) return entry.one;
                if (entry.other !== undefined) return entry.other;
                return entry.one ?? entry.other ?? '';
            }

            function formatTemplate(value, params = {}) {
                if (typeof value !== 'string') return value;
                return value.replace(/\{\{\s*(\w+)\s*\}\}/g, (_, key) => params[key] ?? '');
            }

            function t(key, params = {}, locale = state.currentLocale) {
                const { data } = getLocaleData(locale);
                const fallback = translations.es;
                const value = getFromPath(data, key) ?? getFromPath(fallback, key);
                const resolved = typeof value === 'function' ? value(params) : resolvePlural(value, params);
                return formatTemplate(resolved, params) ?? '';
            }

            function updateI18nAttributes(selector, attr, keyAttr, locale) {
                document.querySelectorAll(selector).forEach(el => {
                    const key = el.dataset[keyAttr];
                    if (!key) return;
                    const params = {};
                    if (el.dataset.i18nCount !== undefined) {
                        params.count = Number(el.dataset.i18nCount);
                    }
                    const translation = t(key, params, locale);
                    if (translation) {
                        if (attr === 'text') {
                            el.textContent = translation;
                        } else {
                            el.setAttribute(attr, translation);
                        }
                    }
                });
            }

            function applyTranslations(locale) {
                const normalized = normalizeLocale(locale);
                document.documentElement.lang = normalized;
                state.currentLocale = normalized;
                saveLocalePreference(normalized);
                document.title = t('meta.title', {}, normalized);
                updateI18nAttributes('[data-i18n]', 'text', 'i18n', normalized);
                updateI18nAttributes('[data-i18n-placeholder]', 'placeholder', 'i18nPlaceholder', normalized);
                updateI18nAttributes('[data-i18n-title]', 'title', 'i18nTitle', normalized);
                updateI18nAttributes('[data-i18n-aria-label]', 'aria-label', 'i18nAriaLabel', normalized);
                updateHistoryCounter();
                renderHistoryList();
                updatePresetDisplay(state.currentPreset);
                updateIncognitoButton();
                updateModelDropdownLabels();
                updateBottomSheetText('model');
                updateBottomSheetText('preset');
                updateWelcomeMessage();
            }

            function handleAppLocaleMessage(event) {
                if (!event || typeof event.data !== 'object' || event.data === null) return;
                const { type, locale } = event.data;
                if (type !== 'appLocaleChanged' || typeof locale !== 'string') return;

                const normalized = normalizeLocale(locale);
                if (normalized !== state.currentLocale) {
                    applyTranslations(normalized);
                }
            }

            window.addEventListener('message', handleAppLocaleMessage);
            window.addEventListener('beforeunload', () => {
                window.removeEventListener('message', handleAppLocaleMessage);
            });

            function updateWelcomeMessage() {
                const welcome = document.querySelector('#welcomeMessage [data-i18n="welcome.message"]');
                if (welcome) {
                    welcome.textContent = t('welcome.message');
                }
            }

            function updateHistoryCounter() {
                const historyCount = document.getElementById('historyCount');
                if (!historyCount) return;
                const currentCount = Number(historyCount.dataset.i18nCount ?? 0);
                historyCount.textContent = t('history.count', { count: currentCount });
            }

            function updateModelDropdownLabels() {
                const selectedModelName = document.getElementById('selectedModelName');
                if (selectedModelName) {
                    selectedModelName.textContent = t(`models.names.${state.currentModel}`);
                }
                document.querySelectorAll('.dropdown-content button').forEach(button => {
                    const model = button.getAttribute('onclick')?.match(/selectModel\('([^']+)'\)/)?.[1];
                    if (!model) return;
                    const label = button.querySelector('span[data-i18n]');
                    if (label) {
                        label.textContent = t(`models.names.${model}`);
                    }
                });
            }

            function updateBottomSheetText(type) {
                if (type === 'model') {
                    document.querySelectorAll('#modelBottomSheet .bottom-sheet-option').forEach(option => {
                        const model = option.dataset.model;
                        if (!model) return;
                        const title = option.querySelector('.font-semibold');
                        const desc = option.querySelector('.text-xs');
                        if (title) title.textContent = t(`models.names.${model}`);
                        if (desc) desc.textContent = t(`models.descriptions.${model}`);
                    });
                    const sheetTitle = document.querySelector('#modelBottomSheet h3 [data-i18n]');
                    if (sheetTitle) sheetTitle.textContent = t('models.sheetTitle');
                } else if (type === 'preset') {
                    document.querySelectorAll('#presetBottomSheet .bottom-sheet-option').forEach(option => {
                        const preset = option.dataset.preset;
                        if (!preset) return;
                        const title = option.querySelector('.font-semibold');
                        const desc = option.querySelector('.text-xs');
                        if (title) title.textContent = t(`presets.labels.${preset}`);
                        if (desc) desc.textContent = t(`presets.descriptions.${preset}`);
                    });
                    const sheetTitle = document.querySelector('#presetBottomSheet h3 [data-i18n]');
                    if (sheetTitle) sheetTitle.textContent = t('presets.sheetTitle');
                }
            }

            function setHistoryCount(count) {
                const historyCount = document.getElementById('historyCount');
                if (historyCount) {
                    historyCount.dataset.i18nCount = String(count);
                    historyCount.textContent = t('history.count', { count });
                }
            }

            // ============================================
            // FUNCIONES DE UTILIDAD
            // ============================================
            function escapeHtml(text) {
                const div = document.createElement("div");
                div.textContent = text;
                return div.innerHTML.replace(/\n/g, "<br>");
            }

            function formatMarkdown(text) {
                if (!text) return "";
                try {
                    const rawHtml = marked.parse(text, {
                        breaks: true,
                        gfm: true
                    });
                    const cleanHtml = DOMPurify.sanitize(rawHtml, {
                        ALLOWED_TAGS: [
                            'p','strong','em','code','pre','ul','ol','li','blockquote','h1','h2','h3','h4','h5','h6','table','thead','tbody','tr','th','td','hr','a','br'
                        ],
                        ALLOWED_ATTR: ['href','title','target','rel']
                    });
                    return cleanHtml;
                } catch (error) {
                    console.error('Error al formatear markdown:', error);
                    return text;
                }
            }

            function showNotification(text) {
                const notification = document.createElement("div");
                notification.className = "fixed bottom-4 right-4 bg-emerald-600 text-white px-6 py-3 rounded-lg shadow-lg z-50";
                notification.textContent = text;
                document.body.appendChild(notification);
                setTimeout(() => notification.remove(), 2000);
            }

            // ============================================
            // FUNCIONES DE ALMACENAMIENTO LOCAL
            // ============================================
            function generateChatId() {
                return 'chat_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            }

            function saveChatToHistory() {
                if (state.isIncognito || state.messages.length === 0) return;
                
                const chatHistory = getChatHistory();
                const chatId = state.currentChatId || generateChatId();
                const chatData = {
                    id: chatId,
                    messages: [...state.messages],
                    model: state.currentModel,
                    preset: state.currentPreset,
                    timestamp: Date.now(),
                    title: generateChatTitle()
                };
                
                // Remove existing chat with same ID if it exists
                const existingIndex = chatHistory.findIndex(chat => chat.id === chatId);
                if (existingIndex !== -1) {
                    chatHistory[existingIndex] = chatData;
                } else {
                    chatHistory.unshift(chatData);
                }
                
                // Keep only last 50 chats
                if (chatHistory.length > 50) {
                    chatHistory.splice(50);
                }
                
                localStorage.setItem('doky_chat_history', JSON.stringify(chatHistory));
                state.currentChatId = chatId;
            }

            function updateChatHistoryTitle(chatId, newTitle) {
                if (!chatId || !newTitle) return;

                try {
                    const chatHistory = getChatHistory();
                    const chatIndex = chatHistory.findIndex(chat => chat.id === chatId);

                    if (chatIndex === -1) return;

                    if (chatHistory[chatIndex].title === newTitle) return;

                    chatHistory[chatIndex] = {
                        ...chatHistory[chatIndex],
                        title: newTitle
                    };

                    localStorage.setItem('doky_chat_history', JSON.stringify(chatHistory));
                    renderHistoryList();
                } catch (error) {
                    console.error('Error updating chat title:', error);
                }
            }

            function generateChatTitle() {
                if (state.generatedTitle && state.generatedTitle.trim()) {
                    return sanitizeTitle(state.generatedTitle);
                }
                return generateFallbackChatTitle();
            }

            function generateFallbackChatTitle() {
                if (state.messages.length === 0) return 'Nueva conversación';

                const firstUserMessage = state.messages.find(msg => msg.role === 'user');
                if (firstUserMessage) {
                    const title = firstUserMessage.content.substring(0, 50);
                    return title.length < 50 ? title : title + '...';
                }

                return 'Conversación sin título';
            }

            function sanitizeTitle(title) {
                if (!title) return '';
                return title.replace(/["'«»]/g, '').replace(/\s+/g, ' ').trim();
            }

            async function maybeGenerateTitleWithAI() {
                if (state.isIncognito) return;
                if (state.titleGenerationInProgress) return;

                const userMessages = state.messages.filter(msg => msg.role === 'user');
                const userMessageCount = userMessages.length;

                if (userMessageCount === 0) return;
                if (userMessageCount > 3) return;
                if (state.generatedTitle && state.lastTitleGenerationCount === userMessageCount) return;

                const systemPrompt = config.presets[state.currentPreset];
                if (!systemPrompt) return;

                const transcript = state.messages.map(msg => {
                    const roleLabel = msg.role === 'user' ? 'Usuario' : 'Asistente';
                    return `${roleLabel}: ${msg.content}`;
                }).join('\n');

                const titleModel = state.currentModel && state.currentModel.startsWith('deepseek')
                    ? state.currentModel
                    : 'deepseek-chat';

                const prompt = `${systemPrompt}\n\nGenera un título breve y descriptivo (máximo 8 palabras) para la siguiente conversación entre un paciente y el asistente médico. Usa el mismo idioma que utilice el paciente. Evita comillas y devuelve solo el título.\n\nConversación completa:\n${transcript}`;

                const targetChatId = state.currentChatId;
                state.titleGenerationInProgress = true;

                try {
                    const response = await puter.ai.chat(prompt, {
                        model: titleModel,
                        stream: true
                    });

                    let titleText = '';
                    for await (const chunk of response) {
                        if (chunk.text) {
                            titleText += String(chunk.text);
                        }
                    }

                    const sanitized = sanitizeTitle(titleText);
                    if (sanitized) {
                        state.generatedTitle = sanitized;
                        state.lastTitleGenerationCount = userMessageCount;

                        if (targetChatId) {
                            updateChatHistoryTitle(targetChatId, sanitized);
                        }
                    }
                } catch (error) {
                    console.error('Error generating chat title:', error);
                } finally {
                    state.titleGenerationInProgress = false;
                }
            }

            function getChatHistory() {
                try {
                    const history = localStorage.getItem('doky_chat_history');
                    return history ? JSON.parse(history) : [];
                } catch (error) {
                    console.error('Error loading chat history:', error);
                    return [];
                }
            }

            function loadChatFromHistory(chatId) {
                const chatHistory = getChatHistory();
                const chat = chatHistory.find(c => c.id === chatId);
                
                if (chat) {
                    state.messages = [...chat.messages];
                    state.currentModel = chat.model;
                    state.currentPreset = chat.preset;
                    state.currentChatId = chat.id;
                    state.isIncognito = false;
                    state.generatedTitle = chat.title ?? null;
                    state.lastTitleGenerationCount = state.messages.filter(msg => msg.role === 'user').length;
                    state.titleGenerationInProgress = false;
                    
                    // Update UI
                    selectModel(chat.model);
                    updatePresetDisplay(chat.preset);
                    updateIncognitoButton();
                    renderChatMessages();
                    toggleHistoryDrawer();
                    
                    // Chat loaded successfully
                }
            }

            function deleteChatFromHistory(chatId) {
                const chatHistory = getChatHistory();
                const filteredHistory = chatHistory.filter(chat => chat.id !== chatId);
                localStorage.setItem('doky_chat_history', JSON.stringify(filteredHistory));
                
                // If deleting current chat, clear it
                if (state.currentChatId === chatId) {
                    clearChat();
                }
                
                renderHistoryList();
                // Chat deleted successfully
            }

            function deleteAllHistory() {
                document.getElementById("deleteAllHistoryModal").classList.add("active");
            }

            function confirmDeleteAllHistory() {
                localStorage.removeItem('doky_chat_history');
                renderHistoryList();
                if (state.currentChatId) {
                    clearChat();
                }
                closeModal();
                // History cleared successfully
            }

