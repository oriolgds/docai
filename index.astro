            function closeBottomSheet(sheetOverlay, options = {}) {
                if (!sheetOverlay) return;

                const { animate = false } = options;
                const innerSheet = sheetOverlay.querySelector('.bottom-sheet');

                const clearStyles = () => {
                    if (innerSheet) {
                        innerSheet.style.transition = '';
                        innerSheet.style.transform = '';
                    }
                    sheetOverlay.dataset.closing = '';
                };

                if (animate && innerSheet) {
                    sheetOverlay.dataset.closing = 'true';
                    innerSheet.style.transition = '';
                    innerSheet.style.transform = 'translateY(100%)';

                    setTimeout(() => {
                        if (sheetOverlay.dataset.closing === 'true') {
                            sheetOverlay.classList.remove('active');
                            clearStyles();
                        }
                    }, 350);
                    return;
                }

                sheetOverlay.classList.remove('active');
                clearStyles();
            }

            function closeBottomSheets() {
                document.querySelectorAll('.bottom-sheet-overlay').forEach(sheet => {
                    closeBottomSheet(sheet);
                });
            }

            function setupBottomSheetGestures() {
                document.querySelectorAll('.bottom-sheet-overlay').forEach(overlay => {
                    const header = overlay.querySelector('.bottom-sheet-header');
                    const sheet = overlay.querySelector('.bottom-sheet');

                    if (!header || !sheet) return;

                    // Prevent browser pull-to-refresh and other touch actions
                    header.style.touchAction = 'none';

                    let startY = 0;
                    let currentY = 0;
                    let isDragging = false;

                    const updateSheetPosition = clientY => {
                        if (!isDragging) return;
                        currentY = clientY;
                        const deltaY = Math.max(currentY - startY, 0);
                        sheet.style.transform = deltaY > 0 ? `translateY(${deltaY}px)` : '';
                    };

                    const cleanupListeners = () => {
                        document.removeEventListener('touchmove', handleTouchMove);
                        document.removeEventListener('touchend', handleTouchEnd);
                        document.removeEventListener('touchcancel', handleTouchEnd);
                        document.removeEventListener('mousemove', handleMouseMove);
                        document.removeEventListener('mouseup', handleMouseEnd);
                    };

                    const endDrag = shouldClose => {
                        if (!isDragging) return;

                        isDragging = false;
                        sheet.style.transition = '';
                        sheet.style.willChange = '';
                        cleanupListeners();

                        if (shouldClose) {
                            closeBottomSheet(overlay, { animate: true });
                        } else {
                            sheet.style.transform = '';
                        }
                    };

                    const handleTouchMove = event => {
                        if (!isDragging) return;
                        const touch = event.touches[0];
                        if (touch) {
                            updateSheetPosition(touch.clientY);
                            event.preventDefault();
                        }
                    };

                    const handleTouchEnd = event => {
                        if (!isDragging) return;

                        const deltaY = Math.max(currentY - startY, 0);
                        const shouldClose = deltaY > 90;
                        endDrag(shouldClose);
                    };

                    const handleMouseMove = event => {
                        if (!isDragging) return;
                        updateSheetPosition(event.clientY);
                        event.preventDefault();
                    };

                    const handleMouseEnd = event => {
                        if (!isDragging) return;

                        const deltaY = Math.max(currentY - startY, 0);
                        const shouldClose = deltaY > 90;
                        endDrag(shouldClose);
                    };

                    header.addEventListener('touchstart', event => {
                        if (!overlay.classList.contains('active')) return;

                        const touch = event.touches[0];
                        if (!touch) return;

                        startY = touch.clientY;
                        currentY = startY;
                        isDragging = true;
                        sheet.style.transition = 'none';
                        sheet.style.willChange = 'transform';

                        document.addEventListener('touchmove', handleTouchMove, { passive: false });
                        document.addEventListener('touchend', handleTouchEnd);
                        document.addEventListener('touchcancel', handleTouchEnd);
                    }, { passive: true });

                    header.addEventListener('mousedown', event => {
                        if (!overlay.classList.contains('active')) return;
                        if (event.button !== 0) return;

                        startY = event.clientY;
                        currentY = startY;
                        isDragging = true;
                        sheet.style.transition = 'none';
                        sheet.style.willChange = 'transform';

                        document.addEventListener('mousemove', handleMouseMove);
                        document.addEventListener('mouseup', handleMouseEnd);
                    });
                });
            }
            
