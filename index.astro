---
// Import the CSS file at the top of your component
import '../styles/main.css';

---
<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title data-i18n="meta.title">Doky - Tu Asistente Médico con IA | Dr. Oriol Giner Díaz</title>
        <script is:inline src="https://js.puter.com/v2/"></script>
        <script is:inline src="https://cdn.tailwindcss.com"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
        <script is:inline src="https://cdn.jsdelivr.net/npm/dompurify@3.0.8/dist/purify.min.js"></script>
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
        />
    </head>

    <body class="bg-gray-900 text-white">
        <!-- Modal para nueva conversación -->
        <div id="newChatModal" class="modal-overlay">
            <div class="modal-content">
                <div class="p-6">
                    <div class="flex items-center gap-3 mb-4">
                        <div
                            class="w-12 h-12 bg-emerald-600 rounded-full flex items-center justify-center"
                        >
                            <i class="fas fa-comment-medical text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white" data-i18n="modals.newChat.title">
                                Nueva Conversación
                            </h3>
                            <p class="text-gray-400 text-sm" data-i18n="modals.newChat.subtitle">
                                Iniciar desde cero
                            </p>
                        </div>
                    </div>
                    <p class="text-gray-300 mb-6" data-i18n="modals.newChat.body">
                        ¿Estás seguro de que quieres iniciar una nueva
                        conversación? Se perderá todo el historial actual.
                    </p>
                    <div class="flex gap-3 justify-end">
                        <button
                            onclick="closeModal()"
                            class="px-6 py-2.5 bg-gray-700 hover:bg-gray-600 rounded-lg font-medium transition-colors"
                            data-i18n="common.cancel"
                        >
                            Cancelar
                        </button>
                        <button
                            onclick="confirmNewChat()"
                            class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 rounded-lg font-medium transition-colors flex items-center gap-2"
                        >
                            <i class="fas fa-check"></i>
                            <span data-i18n="modals.newChat.confirm">Sí, nueva conversación</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- History Drawer -->
        <div id="historyDrawer" class="history-drawer-overlay">
            <div class="history-drawer">
                <div class="history-drawer-header">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-bold flex items-center gap-2">
                            <i class="fas fa-history text-emerald-500"></i>
                            <span data-i18n="history.title">Historial de Chats</span>
                        </h3>
                        <button
                            onclick="toggleHistoryDrawer()"
                            class="text-gray-400 hover:text-white transition-colors"
                        >
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-2 mt-3">
                        <button
                            onclick="deleteAllHistory()"
                            class="text-sm px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors flex items-center gap-1"
                            data-i18n="history.clear"
                        >
                            <i class="fas fa-trash"></i>
                            Eliminar todo
                        </button>
                        <div class="flex-1 text-right">
                            <span id="historyCount" class="text-sm text-gray-400" data-i18n="history.count" data-i18n-count="0">0 chats</span>
                        </div>
                    </div>
                </div>
                <div class="history-drawer-content">
                    <div id="historyList" class="history-list">
                        <!-- History items will be dynamically added here -->
                        <div class="history-empty-state text-center py-8">
                            <i class="fas fa-comments text-4xl text-gray-600 mb-3"></i>
                            <p class="text-gray-400" data-i18n="history.emptyTitle">No hay chats guardados</p>
                            <p class="text-sm text-gray-500 mt-1" data-i18n="history.emptySubtitle">Tus conversaciones aparecerán aquí</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobileMenuDrawer" class="mobile-menu-drawer-overlay">
            <div class="mobile-menu-drawer">
                <div class="mobile-menu-drawer-header">
                    <div class="flex items-center justify-between">
                        <h3 class="text-lg font-bold flex items-center gap-2">
                            <i class="fas fa-bars text-emerald-500"></i>
                            <span data-i18n="menu.title">Menú</span>
                        </h3>
                        <button
                            onclick="toggleMobileMenuDrawer()"
                            class="text-gray-400 hover:text-white transition-colors"
                            aria-label="Cerrar"
                            data-i18n-aria-label="common.close"
                        >
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                </div>
                <div class="mobile-menu-drawer-content">
                    <div class="mobile-menu-list">
                        <!-- History Section -->
                        <div class="mobile-menu-section">
                            <button
                                onclick="openHistoryFromMobileMenu()"
                                class="mobile-menu-item"
                            >
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-emerald-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-history"></i>
                                    </div>
                                    <div class="text-left">
                                        <div class="font-semibold" data-i18n="history.title">Historial de Chats</div>
                                        <div class="text-xs text-gray-400" data-i18n="history.openFromMenu">Ver conversaciones guardadas</div>
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right text-gray-400"></i>
                            </button>
                        </div>

                        <!-- Future sections can be added here -->
                        <!-- 
                        <div class="mobile-menu-section">
                            <button class="mobile-menu-item">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center">
                                        <i class="fas fa-cog"></i>
                                    </div>
                                    <div class="text-left">
                                        <div class="font-semibold">Configuración</div>
                                        <div class="text-xs text-gray-400">Ajustes de la aplicación</div>
                                    </div>
                                </div>
                                <i class="fas fa-chevron-right text-gray-400"></i>
                            </button>
                        </div>
                        -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal para confirmar eliminación de todo el historial -->
        <div id="deleteAllHistoryModal" class="modal-overlay">
            <div class="modal">
                <div class="modal-header">
                    <h3 class="text-lg font-bold flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle text-red-500"></i>
                        Eliminar historial completo
                    </h3>
                    <button
                        onclick="closeModal()"
                        class="text-gray-400 hover:text-white transition-colors"
                    >
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="text-gray-300 mb-4">
                        ¿Estás seguro de que quieres eliminar todo el historial de chats?
                    </p>
                    <div class="bg-red-900/20 border border-red-500/30 rounded-lg p-3 mb-4">
                        <div class="flex items-center gap-2 text-red-400">
                            <i class="fas fa-warning"></i>
                            <span class="font-medium">Esta acción no se puede deshacer</span>
                        </div>
                        <p class="text-red-300 text-sm mt-1">
                            Todos los chats guardados serán eliminados permanentemente.
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button
                        onclick="closeModal()"
                        class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors flex items-center justify-center"
                    >
                        Cancelar
                    </button>
                    <button
                        onclick="confirmDeleteAllHistory()"
                        class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors flex items-center justify-center gap-2"
                    >
                        <i class="fas fa-trash"></i>
                        Eliminar todo
                    </button>
                </div>
            </div>
        </div>

        <!-- Bottom Sheet Modal para Información (Móviles) -->
        <div id="infoBottomSheet" class="bottom-sheet-overlay">
            <div class="bottom-sheet">
                <div class="bottom-sheet-header">
                    <div class="bottom-sheet-handle"></div>
                    <h3 class="text-lg font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-circle-info text-emerald-500"></i>
                        Más información
                    </h3>
                </div>
                <div class="bottom-sheet-content info-bottom-sheet-content">
                    <p class="text-sm text-gray-300 mb-4">
                        Descubre más sobre Doky y el trabajo del Dr. Oriol Giner Díaz.
                    </p>
                    <div class="info-bottom-sheet-links">
                        <a
                            href="https://x.com/docaiapp"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="info-bottom-sheet-link"
                            onclick="closeBottomSheets()"
                        >
                            <span class="info-menu-item-icon info-menu-item-icon--twitter">
                                <i class="fa-brands fa-x-twitter"></i>
                            </span>
                            <div class="flex-1 text-left">
                                <div class="font-semibold">Twitter oficial</div>
                                <div class="text-xs text-gray-400">Novedades y actualizaciones de Doky</div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-emerald-400"></i>
                        </a>
                        <a
                            href="https://oriol.is-a.dev"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="info-bottom-sheet-link"
                            onclick="closeBottomSheets()"
                        >
                            <span class="info-menu-item-icon info-menu-item-icon--portfolio">
                                <i class="fas fa-user-circle"></i>
                            </span>
                            <div class="flex-1 text-left">
                                <div class="font-semibold">Portfolio del creador</div>
                                <div class="text-xs text-gray-400">Conoce a Dr. Oriol Giner Díaz</div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-emerald-400"></i>
                        </a>
                        <a
                            href="https://oriol.is-a.dev/docai"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="info-bottom-sheet-link"
                            onclick="closeBottomSheets()"
                        >
                            <span class="info-menu-item-icon info-menu-item-icon--project">
                                <i class="fas fa-globe"></i>
                            </span>
                            <div class="flex-1 text-left">
                                <div class="font-semibold">Página del proyecto</div>
                                <div class="text-xs text-gray-400">Detalles sobre la plataforma Doky</div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-emerald-400"></i>
                        </a>
                        <a
                            href="https://play.google.com/store/apps/details?id=com.oriolgds.doky"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="info-bottom-sheet-link"
                            onclick="closeBottomSheets()"
                        >
                            <span class="info-menu-item-icon info-menu-item-icon--playstore">
                                <i class="fab fa-google-play"></i>
                            </span>
                            <div class="flex-1 text-left">
                                <div class="font-semibold">Descargar la app</div>
                                <div class="text-xs text-gray-400">Disponible en Google Play</div>
                            </div>
                            <i class="fas fa-arrow-up-right-from-square text-emerald-400"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal para cambio de preset -->
        <div id="presetChangeModal" class="modal-overlay">
            <div class="modal-content">
                <div class="p-6">
                    <div class="flex items-center gap-3 mb-4">
                        <div
                            class="w-12 h-12 bg-amber-600 rounded-full flex items-center justify-center"
                        >
                            <i class="fas fa-exclamation-triangle text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white">
                                Cambiar Preset
                            </h3>
                            <p class="text-gray-400 text-sm">
                                Se requiere limpiar la conversación
                            </p>
                        </div>
                    </div>
                    <p class="text-gray-300 mb-6">
                        Para cambiar el preset de conversación, es necesario
                        limpiar el historial actual. ¿Deseas continuar?
                    </p>
                    <div class="flex gap-3 justify-end">
                        <button
                            onclick="cancelPresetChange()"
                            class="px-6 py-2.5 bg-gray-700 hover:bg-gray-600 rounded-lg font-medium transition-colors"
                        >
                            Cancelar
                        </button>
                        <button
                            onclick="confirmPresetChange()"
                            class="px-6 py-2.5 bg-amber-600 hover:bg-amber-700 rounded-lg font-medium transition-colors flex items-center gap-2"
                        >
                            <i class="fas fa-check"></i>
                            Sí, cambiar preset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-container">
            <!-- Header -->
            <header class="gradient-bg shadow-lg py-4 px-6">
                <div
                    class="max-w-6xl mx-auto flex justify-between items-center"
                >
                    <div class="flex items-center gap-3">
                        <i class="fas fa-heartbeat text-3xl"></i>
                        <div>
                            <h1 class="text-2xl font-bold">Doky</h1>
                            <p class="text-emerald-100 text-sm" data-i18n="header.subtitle">
                                Asistente Médico IA - Dr. Oriol Giner Díaz
                            </p>
                        </div>
                    </div>
                    <div class="header-actions flex items-center gap-3">
                        <!-- Desktop action buttons -->
                        <div class="hidden sm:flex items-center gap-3">
                            <button
                                onclick="showNewChatModal()"
                                class="header-action-button"
                            >
                                <i class="fas fa-plus"></i>
                                <span data-i18n="header.actions.new">Nueva</span>
                            </button>
                            <button
                                onclick="toggleHistoryDrawer()"
                                class="header-action-button"
                                id="historyButton"
                            >
                                <i class="fas fa-history"></i>
                                <span data-i18n="header.actions.history">Historial</span>
                            </button>
                            <div
                                class="preset-dropdown-wrapper"
                                id="presetDropdown"
                            >
                                <button
                                    id="presetSelectBtn"
                                    class="header-action-button"
                                    onclick="togglePresetDropdown()"
                                    data-value="general"
                                >
                                    <span id="presetSelectLabel">💬 General</span>
                                    <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="presetChevron"></i>
                                </button>
                                <div
                                    id="presetOptions"
                                    class="preset-options hidden"
                                >
                                    <button onclick="handlePresetChange('general')"
                                        >💬 General</button
                                    >
                                    <button
                                        onclick="handlePresetChange('diagnostico')"
                                        >🔍 Diagnóstico</button
                                    >
                                    <button onclick="handlePresetChange('sintomas')"
                                        >📋 Análisis de Síntomas</button
                                    >
                                    <button
                                        onclick="handlePresetChange('medicacion')"
                                        >💊 Medicación</button
                                    >
                                    <button
                                        onclick="handlePresetChange('nutricion')"
                                        >🥗 Nutrición</button
                                    >
                                    <button
                                        onclick="handlePresetChange('ejercicio')"
                                        >💪 Ejercicio</button
                                    >
                                </div>
                            </div>
                            <div class="info-menu-wrapper" id="infoMenuWrapper">
                                <button
                                    id="infoMenuButton"
                                    class="header-action-button"
                                    onclick="toggleInfoMenu()"
                                    aria-expanded="false"
                                    aria-controls="infoMenu"
                                >
                                    <i class="fas fa-circle-info"></i>
                                    <span data-i18n="header.actions.info">Más info</span>
                                    <i
                                        class="fas fa-chevron-down text-xs transition-transform duration-200"
                                        id="infoMenuChevron"
                                    ></i>
                                </button>
                                <div id="infoMenu" class="info-menu hidden">
                                    <a
                                        href="https://x.com/docaiapp"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onclick="closeInfoMenu()"
                                    >
                                        <span class="info-menu-item-icon info-menu-item-icon--twitter">
                                            <i class="fa-brands fa-x-twitter"></i>
                                        </span>
                                        <span data-i18n="info.menu.twitter">Twitter de la app</span>
                                    </a>
                                    <a
                                        href="https://oriol.is-a.dev"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onclick="closeInfoMenu()"
                                    >
                                        <span class="info-menu-item-icon info-menu-item-icon--portfolio">
                                            <i class="fas fa-user-circle"></i>
                                        </span>
                                        <span data-i18n="info.menu.portfolio">Portfolio del creador</span>
                                    </a>
                                    <a
                                        href="https://oriol.is-a.dev/docai"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onclick="closeInfoMenu()"
                                    >
                                        <span class="info-menu-item-icon info-menu-item-icon--project">
                                            <i class="fas fa-globe"></i>
                                        </span>
                                        <span data-i18n="info.menu.project">Página del proyecto</span>
                                    </a>
                                    <a
                                        href="https://play.google.com/store/apps/details?id=com.oriolgds.doky"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onclick="closeInfoMenu()"
                                    >
                                        <span class="info-menu-item-icon info-menu-item-icon--playstore">
                                            <i class="fab fa-google-play"></i>
                                        </span>
                                        <span data-i18n="info.menu.playstore">Descargar la app</span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Mobile action buttons -->
                        <div class="mobile-action-bar sm:hidden">
                            <!-- Mobile Menu Button -->
                            <button
                                onclick="toggleMobileMenuDrawer()"
                                class="mobile-menu-button"
                                id="mobileMenuBtn"
                                title="Menú"
                                aria-label="Menú"
                                data-i18n-title="menu.title"
                                data-i18n-aria-label="menu.title"
                            >
                                <i class="fas fa-bars"></i>
                            </button>

                            <!-- Mobile Preset Button -->
                            <button
                                onclick="openPresetBottomSheet()"
                                class="mobile-preset-button"
                                id="mobilePresetBtn"
                                aria-label="Seleccionar modo"
                                data-i18n-aria-label="presets.open"
                            >
                                <span id="mobilePresetLabel">💬</span>
                            </button>

                            <!-- Mobile Info Button -->
                            <button
                                onclick="openInfoBottomSheet()"
                                class="mobile-info-button"
                                title="Más información"
                                aria-label="Más información"
                                data-i18n-title="header.actions.info"
                                data-i18n-aria-label="header.actions.info"
                            >
                                <i class="fas fa-circle-info"></i>
                            </button>

                            <!-- Mobile New Chat Button -->
                            <button
                                onclick="showNewChatModal()"
                                class="mobile-new-chat-button"
                                aria-label="Nueva conversación"
                                data-i18n-aria-label="header.actions.new"
                            >
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Chat Container -->
            <main
                class="chat-container scrollbar-custom px-4 py-6"
                id="chatContainer"
            >
                <div class="max-w-4xl mx-auto">
                    <div
                        id="welcomeMessage"
                        class="message-wrapper text-center mb-6"
                    >
                        <div
                            class="inline-block bg-gradient-to-r from-emerald-600 to-green-500 text-white px-6 py-3 rounded-lg message-enter"
                        >
                            <i class="fas fa-hand-holding-medical mr-2"></i>
                            <span data-i18n="welcome.message">¡Hola! Soy Doky, tu asistente médico creado por el Dr. Oriol Giner Díaz. Estoy aquí para ayudarte con cualquier consulta sobre salud. ¿En qué puedo ayudarte hoy?</span>
                        </div>
                    </div>
                </div>
            </main>

            <!-- Input Area -->
            <footer class="input-area bg-gray-800 border-t border-gray-700">
                <div class="max-w-4xl mx-auto">
                    <!-- Vista Desktop -->
                    <div class="desktop-input-wrapper">
                        <div class="flex items-end gap-3">
                            <div class="flex-1">
                                <textarea
                                    id="messageInput"
                                    placeholder="Escribe tu consulta de salud aquí..."
                                    rows="1"
                                    class="w-full bg-gray-700 text-white px-4 py-3 rounded-lg resize-none focus:outline-none focus:ring-2 focus:ring-emerald-500 scrollbar-custom"
                                    onkeydown="if(event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); sendMessage(); }"
                                    data-i18n-placeholder="input.desktop.placeholder"
                                ></textarea>
                            </div>

                            <!-- Selector de modelo (Desktop) -->
                            <div class="dropdown hidden sm:block" id="modelDropdown">
                                <button
                                    onclick="toggleModelDropdown()"
                                    class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-3 rounded-lg btn-hover flex items-center gap-2 whitespace-nowrap"
                                >
                                    <i id="desktopModelIcon" class="fas fa-brain"></i>
                                    <span id="selectedModelName">Doky</span>
                                    <i class="fas fa-chevron-down text-xs transition-transform duration-200" id="modelChevron"></i>
                                </button>
                                <div class="dropdown-content">
                                    <button onclick="selectModel('deepseek-chat')">
                                        <i class="fas fa-brain mr-2"></i>
                                        <span data-i18n="models.doky">Doky</span>
                                    </button>
                                    <button onclick="selectModel('deepseek-reasoner')">
                                        <i class="fas fa-lightbulb mr-2"></i>
                                        <span data-i18n="models.doky_advanced">Doky Advanced</span>
                                    </button>
                                    <button onclick="selectModel('gpt-5')">
                                        <i class="fas fa-star mr-2"></i>
                                        <span data-i18n="models.doky_fast">Doky Flash</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Botón incógnito (Desktop) -->
                            <button
                                onclick="toggleIncognitoMode()"
                                id="incognitoButton"
                                class="hidden sm:block bg-gray-700 hover:bg-gray-600 text-white px-4 py-3 rounded-lg btn-hover items-center gap-2 whitespace-nowrap"
                                title="Modo incógnito"
                                data-i18n-title="incognito.title"
                            >
                                <i id="incognitoIcon" class="fas fa-user-secret"></i>
                                <span id="incognitoText" data-i18n="incognito.label">Incógnito</span>
                            </button>

                            <!-- Botón de enviar (Desktop) -->
                            <button
                                onclick="sendMessage()"
                                id="sendButton"
                                class="hidden sm:flex bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-3 rounded-lg btn-hover items-center gap-2 whitespace-nowrap"
                            >
                                <i class="fas fa-paper-plane"></i>
                                <span data-i18n="input.actions.send">Enviar</span>
                            </button>
                        </div>
                    </div>

                    <!-- Vista Móvil con textarea integrado -->
                    <div class="mobile-input-wrapper">
                        <div class="mobile-input-container">
                            <div class="mobile-textarea-wrapper">
                                <textarea
                                    id="mobileMessageInput"
                                    placeholder="Escribe tu consulta médica..."
